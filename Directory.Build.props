<Project>
  <!-- Shared by every project under WindowsGSM-Next. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!--
      The engine layer is imported from the legacy app at identical paths so fixes port file-for-file.
      That code has explicit usings and no nullable annotations, so both stay off by default; new code
      opts in per file with `#nullable enable`.
    -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <Version>2.0.0</Version>
    <VersionSuffix>alpha.3</VersionSuffix>
    <Product>WindowsGSM</Product>
    <Company>WindowsGSM</Company>
    <Copyright>WindowsGSM contributors</Copyright>

    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Legacy code trips a large number of style/async warnings; keep the build log readable. -->
    <NoWarn>$(NoWarn);CS1998;CS4014;CS0168;CS0219;CS0649;CS0414;CS8632;CA1416;SYSLIB0014</NoWarn>
  </PropertyGroup>
</Project>
